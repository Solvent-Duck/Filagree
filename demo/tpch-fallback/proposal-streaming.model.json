      "boundary": "internal",
      "subtype": "application",
      "description": "Places an order: checks the customer (c_custkey, c_acctbal), writes the order with o_orderstatus 'O', o_orderpriority and o_totalprice, and one line per part with l_quantity, l_extendedprice, l_discount and the promised l_commitdate.",
      "basis": "declared"
    },
    {
      "id": "service:refresh",
      "kind": "service",
      "label": "Mart dynamic tables",
      "boundary": "internal",
      "subtype": "scheduler",
      "description": "Proposed: the daily REFRESH_MARTS task gives way to one dynamic table per mart, TARGET_LAG = '1 minute', REFRESH_MODE = FULL, reading ORDERS_LIVE for new orders and ORDERS and LINEITEM for history. Rehearsed on 2026-10-26 in the zero-copy clone FILAGREE_WHATIF: created over the share in 4.7s; 10,000 rows and 218,102,223,885.0001 net revenue, the same as the nightly mart; 0 mismatched rows. Suspended after the comparison, because the share never changes and each refresh re-reads 6M lines. SUPPLIER_SCORECARD would follow the same pattern; not rehearsed.",
      "basis": "declared",
      "evidence_ids": [
        "ev:whatif-dt",
        "ev:whatif-compare",
        "ev:whatif-suspend",
        "ev:revenue-sql",
        "ev:supplier-sql"
      ],
      "technology": [
        "Snowflake"
      ]
    },
    {
      "id": "service:shipping",
      "kind": "service",
      "label": "Shipping worker",
      "boundary": "internal",
      "subtype": "worker",
      "description": "Ships each order line: sets l_shipdate when it leaves and l_receiptdate when it arrives (late when l_receiptdate > l_commitdate), records l_returnflag (R returned, A accepted, N not yet received), and rolls o_orderstatus from O to P to F.",
      "basis": "declared"
    },
    {
      "id": "service:streaming",
      "kind": "service",
      "label": "Snowpipe Streaming",
      "boundary": "internal",
      "subtype": "worker",
      "description": "Proposed: a Snowpipe Streaming client beside the orders database sends each new or changed order and line item to Snowflake as it commits, so rows reach ORDERS_LIVE in seconds instead of overnight. Not rehearsed: the clone has no streaming client.",
      "basis": "declared"
    },
