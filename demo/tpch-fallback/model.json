      "id": "service:shipping",
      "kind": "service",
      "label": "Shipping worker",
      "boundary": "internal",
      "subtype": "worker",
      "description": "Ships each order line: sets l_shipdate when it leaves and l_receiptdate when it arrives (late when l_receiptdate > l_commitdate), records l_returnflag (R returned, A accepted, N not yet received), and rolls o_orderstatus from O to P to F.",
