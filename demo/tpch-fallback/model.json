  "snapshot": {
    "id": "tpch-lake-002",
    "source_revision": null,
    "coverage": "complete",
    "scope_description": "The tpch-lake project: the TPC-H sample tables it reads, the two marts it builds, and the Cortex open-weight AI that documents tables and answers questions. Also PartsHub, the wholesale parts business TPC-H models, drawn as declared app parts whose features map onto real TPC-H columns.",
    "omissions": [
      "Sample schemas other than TPCH_SF1 (TPCDS, larger TPC-H scales) are not used.",
      "Warehouse sizing, roles and grants are outside this model.",
      "PartsHub is illustrative: TPC-H describes the business but ships no application code, so its apps, orders database and nightly load are declared, not cited."
    ]
  },
  "entities": [
    {
      "id": "client:customer-portal",
